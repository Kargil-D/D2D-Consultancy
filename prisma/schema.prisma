// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Admin enums
enum Status {
  Active
  Inactive
}

enum OtpPurpose {
  Registration
  ForgotPassword
}

/// Admin permission modules — mirrors the real screens reachable from the admin menu
/// (Home/PM/Sales/Finance department tiles in DepartmentTiles — see src/app/admin/{page,pm,sales,finance}/page.tsx).
/// Deliberately excludes placeholder department tiles with no href yet (CX, Roster, Ticketing, Report).
/// Note: these are policy labels, not yet wired to gate every matching admin API route —
/// only login (Role.status) is enforced today. See RolePermission's doc comment.
enum AdminModule {
  Dashboard
  Destinations
  Campaigns
  TransferTypes
  HotelMaster
  CurrencyMaster
  Employees
  Roles
  HeroSection
  Reviews
  EnquiryConfig
  Leads
  Quotations
  Bookings
}

model Role {
  id          String @id @default(uuid())
  name        String @unique // Admin | Employee | Customer
  description String @default("")
  status      Status @default(Active)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

/// One row per (role, module) — the View/Add/Edit/Delete matrix from the Roles screen.
/// Enforced today only insofar as Role.status gates login (see getCurrentUser / the login
/// route); per-module route gating is a separate, not-yet-built follow-up — flagged rather
/// than faked, since mapping these 10 policy modules onto ~15+ existing admin API routes
/// (several of which don't correspond 1:1, e.g. "Website CMS" spans Hero/Reviews/Destinations)
/// is its own scoped project.
model RolePermission {
  id        String      @id @default(uuid())
  roleId    String
  role      Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    AdminModule
  canView   Boolean     @default(false)
  canAdd    Boolean     @default(false)
  canEdit   Boolean     @default(false)
  canDelete Boolean     @default(false)

  @@unique([roleId, module])
  @@map("role_permissions")
}

model User {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  email           String    @unique
  phoneNumber     String?
  passwordHash    String
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  isEmailVerified Boolean   @default(false)
  isActive        Boolean   @default(false)
  lastLogin       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailOtps             EmailOtp[]
  refreshTokens         RefreshToken[]
  assignedLeads         Lead[]
  bookingsAsExecutive   Booking[]      @relation("BookingExecutive")
  bookingsAsSupport     Booking[]      @relation("CustomerSupport")
  quotationsAsSalesExec Quotation[]    @relation("QuotationSalesExecutive")
  employee              Employee?

  @@index([roleId])
  @@map("users")
}

model EmailOtp {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  email     String
  otpHash   String
  purpose   OtpPurpose
  attempts  Int        @default(0)
  expiresAt DateTime
  isUsed    Boolean    @default(false)

  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@map("email_otps")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Destination {
  id               String  @id @default(uuid())
  name             String
  country          String
  state            String?
  city             String?
  slug             String  @unique
  shortDescription String
  fullDescription  String
  thumbnailImage   String?
  bannerImage      String?
  isPopular        Boolean @default(false)
  displayOrder     Int     @default(0)
  seoTitle         String?
  seoDescription   String?
  importantNotes   String?
  status           Status  @default(Active)
  isDomestic       Boolean @default(false)

  // Audit
  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  campaigns    Campaign[]
  leads        Lead[]
  quotations   Quotation[]
  bookings     Booking[]
  hotelMasters HotelMaster[]

  @@map("destinations")
}

model Campaign {
  id                  String      @id @default(uuid())
  name                String
  destinationId       String
  destination         Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  packageType         String      @default("Standard")
  days                Int         @default(0)
  nights              Int         @default(0)
  startingPrice       Int         @default(0)
  offerPrice          Int?
  thumbnail           String?
  coverBanner         String?
  shortDescription    String      @default("")
  highlights          String[]    @default([])
  inclusions          String[]    @default([])
  exclusions          String[]    @default([])
  bestTimeToVisit     String?
  travelTypes         String[]    @default([])
  isFeatured          Boolean     @default(false)
  isRecentlyViewed    Boolean     @default(false)
  isHeroCampaign      Boolean     @default(false)
  viewDetailsRedirect String?
  slug                String      @unique
  seoTitle            String?
  seoDescription      String?
  status              Status      @default(Active)
  gallery             String[]    @default([])
  bookedByName        String?
  bookedByCity        String?
  bookedByAgo         String?
  activities          Json        @default("[]")
  inclusionsText      String      @default("")
  exclusionsText      String      @default("")
  packageCost         Int         @default(0)
  platformFee         Int         @default(0)
  gstPercent          Float       @default(5)
  marginPrice         Int         @default(0)
  insurancePrice      Int         @default(0)
  noOfPersons         Int?
  pricePerPerson      String?

  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  itineraries Itinerary[]
  hotels      Hotel[]
  transfers   Transfer[]
  quotations  Quotation[]

  @@index([destinationId])
  @@map("campaigns")
}

model Itinerary {
  id                 String   @id @default(uuid())
  packageId          String
  campaign           Campaign @relation(fields: [packageId], references: [id], onDelete: Cascade)
  title              String   @default("")
  overview           String   @default("")
  totalDays          Int      @default(0)
  days               Json     @default("[]")
  status             Status   @default(Active)

  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([packageId])
  @@map("itineraries")
}

model Hotel {
  id        String   @id @default(uuid())
  packageId String
  campaign  Campaign @relation(fields: [packageId], references: [id], onDelete: Cascade)
  hotels    Json     @default("[]")
  status    Status   @default(Active)

  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([packageId])
  @@map("hotels")
}

model Transfer {
  id        String   @id @default(uuid())
  packageId String
  campaign  Campaign @relation(fields: [packageId], references: [id], onDelete: Cascade)
  transfers Json     @default("[]")
  status    Status   @default(Active)

  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([packageId])
  @@map("transfers")
}

model TransferType {
  id     String @id @default(uuid())
  name   String
  status Status @default(Active)

  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@map("transfer_types")
}

model HotelMaster {
  id            String       @id @default(uuid())
  name          String
  destinationId String?
  destination   Destination? @relation(fields: [destinationId], references: [id])
  images        String[]     @default([])
  description   String       @default("")
  category      String?
  roomTypes     String[]     @default([])
  mealPlans     String[]     @default([])
  amenities     String[]     @default([])
  googleMapUrl  String?
  website       String?
  status        Status       @default(Active)

  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([destinationId])
  @@map("hotel_master")
}

enum EmploymentType {
  Permanent
  Contract
  Intern
}

/// PM > Employees. Deliberately standalone from the `User` login/auth model (see the
/// "Login Information" fields below) — this is an HR record, not a second identity system.
/// Aadhaar number and bank account number are AES-256-GCM encrypted at the service layer
/// (src/lib/crypto.ts) before being written here; only their last 4 digits are kept in the
/// clear (aadhaarLast4/accountLast4) so the UI can render the masked form without decrypting.
model Employee {
  id           String @id @default(uuid())
  seq          Int    @unique @default(autoincrement())
  employeeCode String @unique

  // Personal
  fullName        String
  dateOfBirth     DateTime?
  gender          String    @default("")
  mobileNumber    String    @default("")
  personalEmail   String?
  officialEmail   String?
  profilePhotoUrl String?

  // Employment
  designation        String          @default("")
  department          String          @default("")
  branch              String          @default("")
  reportingManagerId  String?
  reportingManager    Employee?       @relation("EmployeeManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports       Employee[]      @relation("EmployeeManager")
  employmentType       EmploymentType @default(Permanent)
  joiningDate          DateTime?
  confirmationDate     DateTime?
  status               Status         @default(Active)

  // Login information. `userId` optionally links this HR record to a real login `User` —
  // when linked, the assigned Role on the Employee screen writes through to User.roleId and
  // actually gates access (see employeeService.setEmployeeRole); `username`/`mfaEnabled` stay
  // as plain reference fields since neither has a real counterpart in the auth model today
  // (User has no username, and there is no MFA implementation anywhere in this app yet).
  username    String?   @unique
  userId      String?   @unique
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  lastLogin   DateTime?
  mfaEnabled  Boolean   @default(false)

  // Address
  currentAddress   String @default("")
  permanentAddress String @default("")
  city             String @default("")
  state            String @default("")
  pinCode          String @default("")
  country          String @default("India")

  // Government IDs
  aadhaarNumberEnc     String?
  aadhaarLast4         String?
  panNumber            String?
  passportNumber       String?
  drivingLicenceNumber String?

  // Bank details
  accountHolderName String      @default("")
  bankName          String      @default("")
  bankBranchName    String      @default("")
  accountNumberEnc  String?
  accountLast4      String?
  ifscCode          String      @default("")
  upiId             String?
  salaryPaymentMode PaymentMode @default(BankTransfer)

  // Emergency contact
  emergencyContactName  String @default("")
  emergencyRelationship String @default("")
  emergencyMobile       String @default("")

  auditLogs    EmployeeAuditLog[]
  rosterEntries RosterEntry[]
  invites       EmployeeInvite[]

  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  @@index([status])
  @@index([reportingManagerId])
  @@map("employees")
}

/// A one-time link sent to an Employee's officialEmail so they can create their own login and
/// set their own password — the Admin never sets or sees a password (see EmployeeForm's "Send
/// Invite" action). tokenHash mirrors RefreshToken's pattern (src/lib/refreshToken.ts): the raw
/// token goes out in the email link and is never persisted, only its SHA-256 hash is stored.
model EmployeeInvite {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  email       String
  tokenHash   String   @unique
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
  createdBy   String
  createdDate DateTime @default(now())

  @@index([employeeId])
  @@map("employee_invites")
}

enum RosterStatus {
  Present
  Absent
}

/// Simple daily attendance roster — Present/Absent per employee per day, no shift types.
model RosterEntry {
  id         String       @id @default(uuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime     @db.Date
  status     RosterStatus
  remarks    String       @default("")
  markedBy   String       @default("")

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@map("roster_entries")
}

/// Minimal audit trail for the Employee module's sensitive fields (Aadhaar/bank account
/// number) — satisfies "record every view and update" without the full Activity Log tab
/// infrastructure. Written by employeeService.ts on create/update/reveal.
model EmployeeAuditLog {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  action      String
  field       String?
  performedBy String
  performedAt DateTime @default(now())

  @@index([employeeId])
  @@map("employee_audit_logs")
}

enum LeadSource {
  Website
  MetaAds
  GoogleAds
  SEO
  WhatsApp
  Referral
  Manual
}

enum LeadStatus {
  New
  Contacted
  FollowUp
  QuotationSent
  PaymentPending
  Won
  Lost
}

model Lead {
  id            String      @id @default(uuid())
  seq           Int         @unique @default(autoincrement())
  customerName  String
  mobile        String
  email         String?
  companyName   String?
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id])
  travelDate    DateTime?
  source        LeadSource
  adults        Int?
  children      Int?
  assignedToId  String?
  assignedTo    User?       @relation(fields: [assignedToId], references: [id])
  remarks       String?
  status        LeadStatus  @default(New)

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  activities LeadActivity[]
  quotations Quotation[]
  bookings   Booking[]
  assignmentLogs LeadAssignmentLog[]

  @@index([destinationId])
  @@index([assignedToId])
  @@map("leads")
}

enum LeadAssignmentMethod {
  Manual
  Reassign
  BulkReassign
  RoundRobin
}

/// One row per assign/reassign event on a Lead — powers the Lead Assignment Board's live
/// feed, round-robin pointer, and "reassigned today" count. fromUserId/toUserId/performedBy
/// are plain snapshot strings (not relations) so the log survives even if a User is later
/// removed, mirroring EmployeeAuditLog's performedBy pattern.
model LeadAssignmentLog {
  id           String               @id @default(uuid())
  leadId       String
  lead         Lead                 @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromUserId   String?
  fromUserName String?
  toUserId     String
  toUserName   String
  method       LeadAssignmentMethod @default(Manual)
  performedBy  String
  createdDate  DateTime             @default(now())

  @@index([leadId])
  @@index([toUserId])
  @@index([createdDate])
  @@map("lead_assignment_logs")
}

model LeadActivity {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  message     String
  createdDate DateTime @default(now())

  @@index([leadId])
  @@map("lead_activities")
}

enum QuotationStatus {
  Draft
  Sent
  Accepted
  Rejected
  Expired
}

enum QuotationComponent {
  Hotel
  Transfer
  Activity
  Visa
  Insurance
  Flight
}

model Quotation {
  id            String          @id @default(uuid())
  seq           Int             @unique @default(autoincrement())
  leadId        String
  lead          Lead            @relation(fields: [leadId], references: [id])
  destinationId String
  destination   Destination     @relation(fields: [destinationId], references: [id])
  campaignId    String?
  campaign      Campaign?       @relation(fields: [campaignId], references: [id])
  marginPercent Float           @default(0)
  gstPercent    Float           @default(5)
  status        QuotationStatus @default(Draft)
  shareToken    String?         @unique

  // Step 1 — Trip & Traveller Details (quotation-specific, independent of the linked Lead's own values)
  travelDate DateTime?
  days       Int?
  nights     Int?
  adults     Int       @default(1)
  children   Int       @default(0)
  infants    Int       @default(0)

  // Step 1 — Other Details
  salesExecutiveId String?
  salesExecutive   User?       @relation("QuotationSalesExecutive", fields: [salesExecutiveId], references: [id])
  source           LeadSource?
  validUntil       DateTime?
  internalNotes    String?

  // Steps 2–5 — Itinerary / Hotels / Transfers / Activities (manual entry, JSON — same pattern as Campaign.activities / Itinerary.days)
  itineraryMode String @default("custom")
  itineraryDays Json   @default("[]")
  hotelOptions  Json   @default("[]")
  transfers     Json   @default("[]")
  activities    Json   @default("[]")

  // Step 6 — Inclusions / Exclusions (free text, one line per bullet — same convention as Campaign.inclusionsText/exclusionsText)
  inclusionsText String @default("")
  exclusionsText String @default("")

  // Step 7 — Pricing: when set, the public quote's Price per Person split gives children an
  // 80/20 discount weighting (80% of package cost / adults, 20% / children) instead of
  // splitting evenly across adults only.
  includeChildCosting Boolean @default(false)

  // Advance required to confirm the booking (defaults to 20% of the selling price in the UI, editable).
  advanceAmount Int @default(0)

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  items    QuotationItem[]
  bookings Booking[]

  @@index([leadId])
  @@index([destinationId])
  @@map("quotations")
}

model QuotationItem {
  id            String             @id @default(uuid())
  quotationId   String
  quotation     Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  component     QuotationComponent
  /**
   * Links this costing row back to its source hotel/activity/transfer id (from the Quotation's JSON content fields) so Pricing stays in sync as those are added/edited/removed. Null for manually-added rows (Visa/Insurance/Flight).
   */
  sourceId      String?
  detail        String             @default("")
  qty           Int                @default(1)
  cost          Int                @default(0)
  currencyCode  String             @default("INR")
  foreignAmount Float?
  exchangeRate  Float              @default(1)
  sortOrder     Int                @default(0)

  @@index([quotationId])
  @@map("quotation_items")
}

model Currency {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  exchangeRate  Float
  effectiveFrom DateTime
  status        Status   @default(Active)

  createdBy   String?
  createdDate DateTime @default(now())
  updatedBy   String?
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  rateHistory CurrencyRateHistory[]

  @@map("currencies")
}

model CurrencyRateHistory {
  id            String   @id @default(uuid())
  currencyId    String
  currency      Currency @relation(fields: [currencyId], references: [id])
  currencyCode  String
  oldRate       Float?
  newRate       Float
  effectiveFrom DateTime
  changedBy     String?
  changedDate   DateTime @default(now())

  @@index([currencyId])
  @@map("currency_rate_history")
}

enum BookingStatus {
  Won
  Booked
  OnTrip
  Completed
  Cancelled
}

/**
 * Discriminator linking a BookingCostSheetEntry back to whichever structured service table (via sourceId) it was generated from.
 */
enum BookingServiceType {
  Flight
  Hotel
  Activity
  Transfer
  Visa
  Insurance
}

enum CostSheetStatus {
  Pending
  Confirmed
  Invoiced
  Settled
}

enum TourType {
  Private
  SIC
}

enum VisaStatus {
  Applied
  Approved
  Rejected
  Issued
}

enum PaymentMode {
  Cash
  BankTransfer
  Card
  UPI
  Cheque
  Other
}

enum SettlementStatus {
  Pending
  Settled
  Partial
}

enum BookingDocumentType {
  Passport
  Visa
  Aadhaar
  PAN
  PassportPhoto
  Other
  /// legacy values, kept for rows written before the Customer Documents rework
  FlightTicket
  Insurance
}

model Booking {
  id                 String        @id @default(uuid())
  seq                Int           @unique @default(autoincrement())
  leadId             String
  lead               Lead          @relation(fields: [leadId], references: [id])
  quotationId        String?
  quotation          Quotation?    @relation(fields: [quotationId], references: [id])
  destinationId      String
  destination        Destination   @relation(fields: [destinationId], references: [id])
  travelDate         DateTime?
  bookingExecutiveId String?
  bookingExecutive   User?         @relation("BookingExecutive", fields: [bookingExecutiveId], references: [id])
  customerSupportId  String?
  customerSupport    User?         @relation("CustomerSupport", fields: [customerSupportId], references: [id])
  totalAmount        Int           @default(0)
  status             BookingStatus @default(Won)
  remarks            String?
  dmcName            String?
  dmcEmailSentDate   DateTime?
  dmcResponse        String?
  dmcRemarks         String?

  createdDate DateTime @default(now())
  updatedDate DateTime @updatedAt
  isDeleted   Boolean  @default(false)

  documents        BookingDocument[]
  flights          BookingFlight[]
  hotels           BookingHotel[]
  activities       BookingActivity[]
  transfers        BookingTransfer[]
  visas            BookingVisa[]
  insurances       BookingInsurance[]
  costSheet        BookingCostSheetEntry[]
  customerPayments BookingCustomerPayment[]
  supplierPayments BookingSupplierPayment[]
  timeline         BookingTimelineEvent[]
  notes            BookingNote[]

  @@index([leadId])
  @@index([bookingExecutiveId])
  @@index([customerSupportId])
  @@map("bookings")
}

model BookingDocument {
  id           String              @id @default(uuid())
  bookingId    String
  booking      Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  type         BookingDocumentType
  url          String
  description  String?
  uploadedDate DateTime            @default(now())

  @@index([bookingId])
  @@map("booking_documents")
}

/// FRD §4 — Flight
model BookingFlight {
  id           String    @id @default(uuid())
  bookingId    String
  booking      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  airline      String    @default("")
  flightNumber String    @default("")
  pnr          String    @default("")
  ticketNumber String    @default("")
  fromLocation String    @default("")
  toLocation   String    @default("")
  departureAt  DateTime?
  arrivalAt    DateTime?
  cabinClass   String    @default("")
  baggage      String    @default("")
  meal         String    @default("")
  supplier     String    @default("")
  ticketUrl    String?
  voucherUrl   String?
  sortOrder    Int       @default(0)

  @@index([bookingId])
  @@map("booking_flights")
}

/// FRD §5 — Hotel
model BookingHotel {
  id                 String    @id @default(uuid())
  bookingId          String
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotelName          String    @default("")
  hotelCategory      String    @default("")
  checkIn            DateTime?
  checkOut           DateTime?
  nights             Int       @default(0)
  rooms              Int       @default(1)
  roomCategory       String    @default("")
  roomType           String    @default("")
  mealPlan           String    @default("")
  occupancy          String    @default("")
  amenities          String[]  @default([])
  hotelAddress       String    @default("")
  googleMapLink      String?
  hotelContactNumber String    @default("")
  supplier           String    @default("")
  voucherUrl         String?
  bookedCurrency     String    @default("INR")
  paymentMode        PaymentMode @default(Cash)
  bookingDate        DateTime?
  bookingPnr         String    @default("")
  updatedBy          String    @default("")
  sortOrder          Int       @default(0)

  @@index([bookingId])
  @@map("booking_hotels")
}

/// FRD §6 — Activity
model BookingActivity {
  id             String    @id @default(uuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  activityName   String    @default("")
  activityDate   DateTime?
  activityTime   String    @default("")
  duration       String    @default("")
  tourType       TourType  @default(Private)
  pickupIncluded Boolean   @default(false)
  pickupTime     String    @default("")
  pax            Int       @default(1)
  supplier       String    @default("")
  voucherUrl     String?
  invoiceUrl     String?
  bookedCurrency String    @default("INR")
  paymentMode    PaymentMode @default(Cash)
  bookingDate    DateTime?
  bookingPnr     String    @default("")
  updatedBy      String    @default("")
  sortOrder      Int       @default(0)

  @@index([bookingId])
  @@map("booking_activities")
}

/// FRD §7 — Transfer
model BookingTransfer {
  id             String    @id @default(uuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transferType   String    @default("")
  vehicleType    String    @default("")
  mode           TourType  @default(Private)
  pickupAt       DateTime?
  pickupLocation String    @default("")
  dropLocation   String    @default("")
  driverName     String    @default("")
  driverMobile   String    @default("")
  vehicleNumber  String    @default("")
  supplier       String    @default("")
  voucherUrl     String?
  invoiceUrl     String?
  bookedCurrency String    @default("INR")
  paymentMode    PaymentMode @default(Cash)
  bookingDate    DateTime?
  bookingPnr     String    @default("")
  updatedBy      String    @default("")
  sortOrder      Int       @default(0)

  @@index([bookingId])
  @@map("booking_transfers")
}

/// FRD §8 — Visa
model BookingVisa {
  id              String     @id @default(uuid())
  bookingId       String
  booking         Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  country         String     @default("")
  visaType        String     @default("")
  visaNumber      String     @default("")
  applicationDate DateTime?
  issueDate       DateTime?
  expiryDate      DateTime?
  status          VisaStatus @default(Applied)
  supplier        String     @default("")
  visaCopyUrl     String?
  sortOrder       Int        @default(0)

  @@index([bookingId])
  @@map("booking_visas")
}

/// FRD §9 — Insurance
model BookingInsurance {
  id               String    @id @default(uuid())
  bookingId        String
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  insuranceCompany String    @default("")
  policyNumber     String    @default("")
  planName         String    @default("")
  coverageAmount   Int       @default(0)
  travelStartDate  DateTime?
  travelEndDate    DateTime?
  policyPdfUrl     String?
  sortOrder        Int       @default(0)

  @@index([bookingId])
  @@map("booking_insurances")
}

/// FRD §3 — Cost Sheet. One entry per structured-service row (matched by sourceId), auto-reconciled — same pattern as QuotationItem.sourceId.
model BookingCostSheetEntry {
  id             String             @id @default(uuid())
  bookingId      String
  booking        Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceType    BookingServiceType
  sourceId       String
  supplierName   String             @default("")
  serviceName    String             @default("")
  bookingCost    Int                @default(0)
  settlementCost Int                @default(0)
  sellingPrice   Int                @default(0)
  status         CostSheetStatus    @default(Pending)
  remarks        String?
  sortOrder      Int                @default(0)

  @@index([bookingId])
  @@map("booking_cost_sheet_entries")
}

/// FRD §10 — Customer Payment
model BookingCustomerPayment {
  id                   String      @id @default(uuid())
  bookingId            String
  booking              Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  paymentDate          DateTime
  paymentMode          PaymentMode @default(Cash)
  amount               Int
  transactionReference String?
  remarks              String?
  createdDate          DateTime    @default(now())

  @@index([bookingId])
  @@map("booking_customer_payments")
}

/// FRD §10 — Supplier Payment
model BookingSupplierPayment {
  id                   String           @id @default(uuid())
  bookingId            String
  booking              Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  supplierName         String
  paymentDate          DateTime
  amount               Int
  paymentMode          PaymentMode      @default(Cash)
  transactionReference String?
  settlementStatus     SettlementStatus @default(Pending)
  createdDate          DateTime         @default(now())

  @@index([bookingId])
  @@map("booking_supplier_payments")
}

/// FRD §13 — Timeline. Verbatim copy of the LeadActivity pattern.
model BookingTimelineEvent {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  message     String
  createdDate DateTime @default(now())

  @@index([bookingId])
  @@map("booking_timeline_events")
}

/// FRD §12 — Customer Chat's "Internal Notes" half (WhatsApp/Email are external integrations, not built here).
model BookingNote {
  id          String   @id @default(uuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  authorName  String   @default("")
  message     String
  createdDate DateTime @default(now())

  @@index([bookingId])
  @@map("booking_notes")
}
